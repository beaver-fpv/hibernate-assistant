<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource CountdownBackground}">
  <Viewbox Margin="48" Stretch="Uniform" StretchDirection="DownOnly">
    <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="即将休眠" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock x:Name="CountdownNumber" Text="5" FontFamily="Segoe UI" FontWeight="Light" FontSize="192" LineHeight="220" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}" AutomationProperties.Name="休眠倒计时剩余秒数"/>
      <TextBlock Text="秒后保存工作状态" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,32"/>
      <Button x:Name="FullscreenCancelButton" Content="取消休眠" HorizontalAlignment="Center" MinWidth="220" MinHeight="54" FontSize="18" FontWeight="SemiBold" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Text="也可以按 Esc 取消" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,14,0,0"/>
    </StackPanel>
  </Viewbox>
</Grid>
